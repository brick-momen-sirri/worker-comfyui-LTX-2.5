# syntax=docker/dockerfile:1.7.1@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
# Standalone sibling image; never installs DFR into the ComfyUI environment.
FROM nvidia/cuda:13.0.2-base-ubuntu24.04@sha256:2ab6381d970b211fb93853796dc6707eb8a72575a375c422b17cf4d8b2641701 AS runtime

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_INPUT=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_NO_CACHE=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    DO_NOT_TRACK=1 \
    DFR_MODEL_ROOT=/models/ltx25 \
    DFR_EXECUTION_TIMEOUT_S=3600 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# A dated Ubuntu snapshot pins OS package resolution as well as the base digest.
RUN sed -i -E 's#https?://(archive\.ubuntu\.com/ubuntu/?|security\.ubuntu\.com/ubuntu/?)#https://snapshot.ubuntu.com/ubuntu/20260910T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && packages=(python3.12 python3.12-venv ca-certificates git ffmpeg \
       libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 libsndfile1 \
       libtcmalloc-minimal4 openssh-server tini) \
    && apt-get -o Acquire::Check-Valid-Until=false --print-uris -qq --no-install-recommends install "${packages[@]}" > /tmp/apt-uris \
    && awk 'NF == 4 {print $1, "/var/cache/apt/archives/" $2, $4}' /tmp/apt-uris \
       | xargs -r -n3 -P8 /usr/lib/apt/apt-helper -o Acquire::Retries=3 download-file \
    && apt-get -o Acquire::Check-Valid-Until=false install -y --no-download --no-install-recommends "${packages[@]}" \
    && rm -f /tmp/apt-uris \
    && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_* \
    && python3.12 -m venv /opt/venv

COPY requirements/bootstrap.lock /requirements/bootstrap.lock
RUN python -m pip install --require-hashes -r /requirements/bootstrap.lock

COPY requirements/dfr.lock /requirements/dfr.lock
RUN uv pip sync --python /opt/venv/bin/python --require-hashes /requirements/dfr.lock
COPY sources.dfr.lock.json /sources.dfr.lock.json
COPY scripts/fetch_sources.py /scripts/fetch_sources.py
RUN python /scripts/fetch_sources.py /sources.dfr.lock.json \
    && uv pip install --python /opt/venv/bin/python --no-deps --no-build-isolation \
       /opt/ltx/packages/ltx-core /opt/ltx/packages/ltx-pipelines

COPY handler.py credit_estimator.py dfr_worker.py /
COPY src/network_volume.py /network_volume.py
COPY ltx_worker /ltx_worker
COPY models/profiles/dfr.json /models-manifest.json
COPY scripts/download_models.py scripts/dfr_preflight.py scripts/dfr_build_smoke.py /scripts/
COPY src/start-dfr.sh /start-dfr.sh
RUN sed -i 's/\r$//' /start-dfr.sh \
    && chmod 755 /start-dfr.sh \
    && mkdir -p /models/ltx25 \
    && python -m compileall -q /dfr_worker.py /ltx_worker /scripts \
    && PYTHONPATH=/ python /scripts/dfr_build_smoke.py

WORKDIR /
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 CMD python -c "import os,pathlib; os.kill(int(pathlib.Path('/tmp/dfr-worker.pid').read_text()), 0)"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/start-dfr.sh"]

FROM runtime AS final
RUN --mount=type=secret,id=hf_token,required=true \
    python /scripts/download_models.py --manifest /models-manifest.json --root /models/ltx25 \
      --token-file /run/secrets/hf_token --workers 3 \
    && python /scripts/download_models.py --manifest /models-manifest.json --root /models/ltx25 \
      --verify-only --size-only
LABEL org.opencontainers.image.title="Runpod LTX 2.5 official DFR 4K worker" \
      io.ltx.backend="official-python-dfr" \
      io.ltx.source-revision="a95ab856bf29407b6b066ede0abe1846050db56c" \
      io.ltx.model-profile="dfr-bf16-cpu-offload"
