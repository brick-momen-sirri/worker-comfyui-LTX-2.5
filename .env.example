# Runtime template only. Keep actual values in Runpod secrets or a private env file.
# These are the original worker's S3 variables. Its SDK uses monthly MM-YY buckets.
BUCKET_ENDPOINT_URL=https://YOUR-S3-ENDPOINT
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
# Optional only if used by the pinned Runpod SDK/backend:
BUCKET_REGION=

# Production API boundary; set true only for trusted legacy workflow callers.
ALLOW_CUSTOM_WORKFLOWS=false
WORKFLOW_EXECUTION_TIMEOUT_S=3600
COMFY_STARTUP_TIMEOUT=300
COMFY_RESERVE_VRAM=2
COMFY_LOG_LEVEL=INFO
COMFY_INPUT_DIR=/comfyui/input
COMFY_OUTPUT_DIR=/comfyui/output
# Blank uses the image profile's admission floor: INT8 23 GiB / BF16 or CQ V2 47 GiB.
# This allows nominal 24/48 GB cards; actual workflow memory fit requires GPU tests.
# INT8 production qualification starts at RTX 6000 Ada 48 GB + 64 GB host RAM.
LTX_MIN_VRAM_GB=
REFRESH_WORKER=false

# Media and workload admission policies. Values are bytes, pixels, frames, seconds.
MAX_IMAGE_BYTES=20971520
MAX_MEDIA_BYTES=268435456
MAX_IMAGE_PIXELS=40000000
MAX_VIDEO_PIXELS=8847360
MAX_INPUT_DURATION_S=120
INPUT_DOWNLOAD_TIMEOUT_S=300
MEDIA_PROCESS_TIMEOUT_S=180
MAX_GENERATION_PIXELS=1572864
# CQ V2 has a separate cap for aligned 1920x1088 inference. GPU fit is workload-dependent.
MAX_CQ_GENERATION_PIXELS=2088960
# Experimental 2560x1440 CQ: set BOTH CQ pixel caps to 3686400.
# Defaults keep Full HD admission. CQ output falls back to MAX_OUTPUT_PIXELS when unset.
MAX_CQ_OUTPUT_PIXELS=2088960
# Above Full HD, default to tested short sections. Raising this requires GPU qualification.
# A single 121-frame experiment sets 121 here; the manifest still caps all CQ jobs at 153.
MAX_CQ_HIGH_RES_FRAMES=25
MAX_GENERATION_FRAMES=241
MAX_GENERATION_DURATION_S=20
MAX_OUTPUT_PIXELS=2088960
# Only the two fixed-UHD modes use these aligned-render admission limits.
MAX_4K_GENERATION_PIXELS=2088960
MAX_4K_OUTPUT_PIXELS=8355840
# Experimental single-pass 4K profile; nine-frame default plus 121-frame qualification.
MAX_NATIVE_4K_GENERATION_PIXELS=8355840
MAX_INLINE_OUTPUT_BYTES=5242880
MAX_RESULT_BYTES=8388608
# Comma-separated exact hostnames; empty permits any vetted public HTTPS host.
INPUT_ALLOWED_HOSTS=

# Local development only; Runpod injects its own worker service credentials.
SERVE_API_LOCALLY=false
# The local image-transport smoke requires SERVE_API_LOCALLY=true and
# ALLOW_CUSTOM_WORKFLOWS=true, with BUCKET_ENDPOINT_URL/S3 credentials unset.
# Do not pass this production S3 template unchanged to that smoke test.
# Optional preserved SSH public key, never a private key:
# PUBLIC_KEY=ssh-ed25519 ...
# Optional legacy credit tracker override:
# CREDIT_TRACKER_DB_PATH=/comfyui/custom_nodes/comfyui_credit_tracker/usage_log.db
# Optional Comfy.org key for trusted legacy paid API graphs; LTX modes do not need it:
# COMFY_ORG_API_KEY=
# Never put an HF token here. Models use a BuildKit secret at image-build time.
# MODEL_PROFILE=int8 (default), bf16, or cq-v2 is a Docker build argument, not a runtime setting.
